{
  "week": "09",
  "title": "Workflows reutilizables",
  "checks": [
    {
      "id": "reusables-only-call",
      "description": "_python.yml, _node.yml e _image.yml solo se disparan con workflow_call",
      "cmd": "for f in _python _node _image; do printf '%s=%s ' \"$f\" \"$(yq '.on | keys | join(\",\")' .github/workflows/$f.yml)\"; done",
      "assert": "stdout~^_python=workflow_call _node=workflow_call _image=workflow_call $",
      "hint": "2-practicas/01-primer-reutilizable.md, paso 1"
    },
    {
      "id": "python-inputs",
      "description": "_python.yml declara los inputs working-directory y package (string), coverage-min (number) e integration (boolean)",
      "cmd": "yq '.on.workflow_call.inputs // {} | to_entries | map(.key + \":\" + .value.type) | sort | join(\",\")' .github/workflows/_python.yml",
      "assert": "stdout~^coverage-min:number,integration:boolean,package:string,working-directory:string$",
      "hint": "3-proyecto/starter/.github/workflows/_python.yml, TODO 1"
    },
    {
      "id": "python-integration-optional",
      "description": "El job integration de _python.yml solo corre si el input integration es true",
      "cmd": "yq '.jobs.integration.if' .github/workflows/_python.yml",
      "assert": "stdout~^(\\$\\{\\{ *)?inputs\\.integration( *\\}\\})?$",
      "hint": "3-proyecto/starter/.github/workflows/_python.yml, TODO 3"
    },
    {
      "id": "node-matrix-from-input",
      "description": "La matriz de tests de _node.yml sale del input node-versions con fromJSON",
      "cmd": "yq '.jobs.test.strategy.matrix.node' .github/workflows/_node.yml",
      "assert": "stdout~^\\$\\{\\{ *fromJSON\\(inputs\\.node-versions\\) *\\}\\}$",
      "hint": "2-practicas/02-inputs-tipados-y-matrices.md, paso 2"
    },
    {
      "id": "node-artifact-output",
      "description": "_node.yml devuelve el nombre del artefacto como output artifact-name, sacado del job build",
      "cmd": "yq '.on.workflow_call.outputs.[\"artifact-name\"].value' .github/workflows/_node.yml",
      "assert": "stdout~^\\$\\{\\{ *jobs\\.build\\.outputs\\.artifact-name *\\}\\}$",
      "hint": "3-proyecto/starter/.github/workflows/_node.yml, TODO 5"
    },
    {
      "id": "image-secret",
      "description": "_image.yml declara el secreto registry-password como obligatorio",
      "cmd": "yq '.on.workflow_call.secrets[\"registry-password\"].required' .github/workflows/_image.yml",
      "assert": "stdout~^true$",
      "hint": "2-practicas/03-secretos-y-outputs.md, paso 1"
    },
    {
      "id": "image-digest-output",
      "description": "_image.yml devuelve el digest de la imagen como output digest, sacado del job build",
      "cmd": "yq '.on.workflow_call.outputs.digest.value' .github/workflows/_image.yml",
      "assert": "stdout~^\\$\\{\\{ *jobs\\.build\\.outputs\\.digest *\\}\\}$",
      "hint": "3-proyecto/starter/.github/workflows/_image.yml, TODO 7"
    },
    {
      "id": "ci-api-calls-python",
      "description": "ci-api.yml tiene un único job y ese job llama a _python.yml",
      "cmd": "yq '[.jobs[] | .uses // \"sin uses\"] | join(\",\")' .github/workflows/ci-api.yml",
      "assert": "stdout~^\\./\\.github/workflows/_python\\.yml$",
      "hint": "2-practicas/01-primer-reutilizable.md, paso 3"
    },
    {
      "id": "ci-web-calls-node",
      "description": "El job web de ci-web.yml llama a _node.yml y dist-report descarga el artefacto que este devuelve",
      "cmd": "yq '.jobs.web.uses + \" \" + (.jobs[\"dist-report\"].steps[] | select(.uses // \"\" | test(\"download-artifact\")) | .with.name)' .github/workflows/ci-web.yml",
      "assert": "stdout~^\\./\\.github/workflows/_node\\.yml \\$\\{\\{ *needs\\.web\\.outputs\\.artifact-name *\\}\\}$",
      "hint": "2-practicas/02-inputs-tipados-y-matrices.md, paso 4"
    },
    {
      "id": "images-calls-image",
      "description": "images.yml llama a _image.yml desde dos jobs, api y web, y les pasa registry-password de forma explícita",
      "cmd": "yq '[.jobs.api, .jobs.web] | map((.uses // \"\") + \"|\" + (.with.component // \"\") + \"|\" + (.secrets[\"registry-password\"] // \"\")) | join(\",\")' .github/workflows/images.yml",
      "assert": "stdout~^\\./\\.github/workflows/_image\\.yml\\|api\\|\\$\\{\\{ *secrets\\.GITHUB_TOKEN *\\}\\},\\./\\.github/workflows/_image\\.yml\\|web\\|\\$\\{\\{ *secrets\\.GITHUB_TOKEN *\\}\\}$",
      "hint": "2-practicas/03-secretos-y-outputs.md, paso 3"
    },
    {
      "id": "images-permissions",
      "description": "En images.yml solo los jobs api y web conceden packages: write; la raíz se queda en contents: read",
      "cmd": "yq '[(.permissions | to_entries | map(.key + \":\" + .value) | join(\";\")), .jobs.api.permissions.packages, .jobs.web.permissions.packages] | join(\",\")' .github/workflows/images.yml",
      "assert": "stdout~^contents:read,write,write$",
      "hint": "2-practicas/03-secretos-y-outputs.md, paso 3"
    },
    {
      "id": "images-digests-summary",
      "description": "El job summary de images.yml espera a api y web y recibe sus digests por env:",
      "cmd": "yq '(.jobs.summary.needs | sort | join(\",\")) + \" \" + ([.jobs.summary.steps[].env // {} | .[]] | join(\" \"))' .github/workflows/images.yml",
      "assert": "stdout~^api,web .*needs\\.api\\.outputs\\.digest.*needs\\.web\\.outputs\\.digest",
      "hint": "2-practicas/03-secretos-y-outputs.md, paso 4"
    },
    {
      "id": "paths-include-reusable",
      "description": "Los filtros paths de ci-api, ci-web e images, en push y en pull_request, incluyen el reutilizable que llaman",
      "cmd": "for p in ci-api:_python ci-web:_node images:_image; do w=${p%%:*}; r=${p#*:}; for e in push pull_request; do yq \".on.$e.paths // [] | contains([\\\".github/workflows/$r.yml\\\"])\" .github/workflows/$w.yml | grep -qx true || echo \"$w $e: falta .github/workflows/$r.yml\"; done; done",
      "assert": "stdout!~.",
      "hint": "2-practicas/04-limites-y-depuracion.md, paso 1"
    },
    {
      "id": "no-secrets-inherit",
      "description": "Ningún workflow usa secrets: inherit",
      "cmd": "grep -nE '^[^#]*secrets: *inherit' .github/workflows/*.yml || true",
      "assert": "stdout!~.",
      "hint": "1-teoria/04-secretos-en-reutilizables.md"
    },
    {
      "id": "jobs-timeout",
      "description": "Todo job con runs-on, en cualquier workflow, declara timeout-minutes",
      "cmd": "for f in .github/workflows/*.yml; do yq '.jobs // {} | to_entries | .[] | select(.value | has(\"runs-on\")) | select(.value | has(\"timeout-minutes\") | not) | .key' \"$f\" | sed \"s|^|$f: |\"; done",
      "assert": "stdout!~.",
      "hint": "1-teoria/02-llamar-a-un-reutilizable.md, apartado 3"
    },
    {
      "id": "workflows-lint",
      "description": "Todos tus workflows pasan actionlint y zizmor",
      "cmd": "actionlint && zizmor --offline -q .github/workflows/",
      "assert": "exit0",
      "hint": "2-practicas/04-limites-y-depuracion.md, paso 5"
    },
    {
      "id": "workflows-pinned",
      "description": "Toda uses: remota de tus workflows está fijada por SHA de 40 caracteres con el tag en comentario",
      "cmd": "grep -hE '^\\s*-?\\s*uses:' .github/workflows/*.yml | grep -vE 'uses: \\./|@[0-9a-f]{40} # v' || true",
      "assert": "stdout!~.",
      "hint": "Semana 01, 2-practicas/04-actionlint-y-sha.md, paso 3"
    },
    {
      "id": "callers-green-on-main",
      "description": "ci-api, ci-web e images terminaron en success sobre el último commit de main",
      "cmd": "git fetch -q origin main && sha=$(git rev-parse origin/main) && for w in ci-api ci-web images; do printf '%s=%s ' \"$w\" \"$(gh run list --workflow $w.yml --commit \"$sha\" --json conclusion --jq '.[0].conclusion')\"; done",
      "assert": "stdout~^ci-api=success ci-web=success images=success $",
      "hint": "3-proyecto/README.md, Cómo entregarlo, paso 3"
    }
  ]
}
